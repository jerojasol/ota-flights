# Copy to .env to override. Every value below is also the default in docker-compose.yml,
# so the stack boots without a .env file.

# --- postgres (credentials also used by flight-aggregator) ---
POSTGRES_DB=flights                 # database name
POSTGRES_USER=flights               # database user
POSTGRES_PASSWORD=flights           # database password

# --- flight-aggregator ---
MARKUP_PERCENTAGE=5                 # markup applied to base price, in percent
REFERENCE_CURRENCY=EUR              # the only accepted currency; offers quoted in any other are rejected (no FX)
FRESHNESS_TTL=10m                   # how long a route's aggregated results count as FRESH
LOCK_TTL=30s                        # TTL of the per-route aggregation lock in Redis
PROVIDER_TIMEOUT=5500ms             # per-request timeout to each provider
PROVIDER_BUDGET=6s                  # total time budget for fanning out to all providers
WARM_ROUTES=MAD-JFK,MAD-LHR,BCN-JFK # routes pre-aggregated on a schedule
WARM_INTERVAL=PT10M                 # interval between warm-up runs (ISO-8601)

# --- mock-providers ---
MOCK_SEED=42                        # deterministic data seed
MOCK_INVENTORY_SIZE=500             # itineraries per provider per query
MOCK_OVERLAP_RATIO=0.30             # fraction shared across providers (dedup)
MOCK_INVALID_RATIO=0.05             # fraction intentionally invalid
MOCK_CHAOS_ENABLED=true             # artificial latency and errors on/off
MOCK_LATENCY_MIN=100ms              # min artificial latency
MOCK_LATENCY_MAX=5000ms             # max artificial latency
MOCK_ERROR_RATE=0.10                # probability of HTTP 500 per request
